# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
PROJECT_NAME="Distributed Task & Job Engine"

# Security
SECRET_KEY=dev-secret-key-change-this-in-production-super-secure-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (PostgreSQL / SQLite fallback for testing)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_engine_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_engine_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Rate Limiter
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
